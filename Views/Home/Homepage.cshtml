<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Film Arama Uygulaması</title>
    <link rel="stylesheet" href="~/css/homepage.css" />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">
    <!-- Font Awesome ikonları için CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            background-color: #0d0d0d;
            color: #fff;
        }
        /* BURADAKİ DÜZELTME: highlight-overlay'in fare olaylarını engellemesini önle */
        .highlight-overlay {
            pointer-events: none; /* Fare olaylarını altındaki öğelere geçirir */
        }
    </style>
</head>
<body>

    <div id="mainContentWrapper" class="p-6 transition-filter duration-300">
        <div class="category-bar">
            <a href="#" class="cat-btn all" data-category="Tümü"><span>📽️ All</span></a>
            <a href="#" class="cat-btn action" data-category="Aksiyon"><span>🔫 Action</span></a>
            <a href="#" class="cat-btn comedy" data-category="Komedi"><span>🤣 Comedy</span></a>
            <a href="#" class="cat-btn drama" data-category="Dram"><span>🎭 Drama</span></a>
            <a href="#" class="cat-btn scifi" data-category="Bilim Kurgu"><span>🚀 Sci-Fi</span></a>
            <a href="#" class="cat-btn fantasy" data-category="Fantastik"><span>🧙‍♂️ Fantasy</span></a>
            <a href="#" class="cat-btn horror" data-category="Korku"><span>🧛‍♂️ Horror</span></a>
        </div>

        <div class="fancy-search">
            <input type="text" id="searchInput" placeholder="Search for movies or series...">
        </div>

        <p class="text-center text-gray-400 mt-2">
            For a more detailed search, you are just a <a href="#" id="openDetailedSearch" class="text-yellow-400 underline hover:text-yellow-300 transition">click</a> away.
        </p>

        <h2 class="weekly-highlight-main-title">
            This Week's Top Picks
        </h2>

        <div class="weekly-highlight-section">

            <div class="highlight-image-wrapper">
                <div class="highlight-slider">
                    <div class="slider-track">
                        <div class="highlight-slide">
                            <img src="~/images/percyJackson.jpeg" alt="Percy Jackson and the Olympians" />
                            <div class="slide-info">
                            </div>
                        </div>
                        <div class="highlight-slide">
                            <img src="~/images/harry-potter.jpg" alt="Harry Potter" />
                            <div class="slide-info">
                            </div>
                        </div>
                        <div class="highlight-slide">
                            <img src="~/images/avatar.jpg" alt="Avatar" />
                            <div class="slide-info">
                            </div>
                        </div>
                        <div class="highlight-slide">
                            <img src="~/images/bladeRunner.jpg" alt="Blade Runner 2049" />
                            <div class="slide-info">
                            </div>
                        </div>
                        <div class="highlight-slide">
                            <img src="~/images/dune-part-two.jpg" alt="Dune: Part Two" />
                            <div class="slide-info">
                            </div>
                        </div>
                        <div class="highlight-slide">
                            <img src="~/images/guardiansOfGalaxy.jpg" alt="Guardians Of Galaxy" />
                            <div class="slide-info">
                            </div>
                        </div>
                        <div class="highlight-slide">
                            <img src="~/images/theConjuring.jpg" alt="The Conjuring" />
                            <div class="slide-info">
                            </div>
                        </div>
                    </div>
                    <button class="slider-button prev-button"><i class="fas fa-chevron-left"></i></button>
                    <button class="slider-button next-button"><i class="fas fa-chevron-right"></i></button>

                </div>
                <!-- highlight-overlay'e pointer-events: none; eklendi -->
                <div class="highlight-overlay"></div>
                <div class="highlight-content">
                    <h1 class="highlight-title">Movie Title Goes Here</h1>
                    <p class="highlight-description">Short Movie Description.</p>
                    <div class="highlight-actions">
                        <button class="details-btn"><i class="fas fa-play-circle"></i> Details</button>
                        <button class="add-to-list-btn"><i class="fas fa-plus-circle"></i> Add to List</button>
                    </div>
                </div>
            </div>
        </div>
        <div id="movieStripContainer" class="movie-strip-container">
        </div>

        @await Component.InvokeAsync("UpcomingMovies")

    </div>

    @* Modal Partial View'i burada çağırıyoruz *@
    @Html.Partial("_DetailedSearchModal")

    @section Scripts {
        <script src="~/js/homepage.js" asp-append-version="true"></script>
        <script src="~/js/detailedSearchModal.js" asp-append-version="true"></script>
        <script src="~/js/upcomingMoviesComponent.js" asp-append-version="true"></script> @* Yeni eklediğiniz satır *@
    }

</body>
</html>
