@* Views/Shared/Components/MovieDetailsModal/Default.cshtml *@
@model CinemaHub.Models.MyListItem
@* Model tipi MyListItem oldu *@

@* Sadece modalın içindeki dinamik içerik buraya gelecek.
   Modalın dış iskeleti (_Layout.cshtml'de) zaten sabit. *@

<link rel="stylesheet" href="~/css/modal-details.css" asp-append-version="true" />

@if (Model != null && Model.Id != -1)
{
    <img src="@Url.Content(Model.Src)" alt="@Model.Title Poster">
    <div class="modal-details">
        <div>
            <h2>@Model.Title</h2>
            <p><strong>Type:</strong> @Model.Type</p>
            <p><strong>Genre:</strong> @Model.Category</p>
            <p><strong>Release Year:</strong> @Model.ReleaseYear</p>
            <p><strong>Director(s):</strong> @(Model.Directors != null && Model.Directors.Any() ? string.Join(", ", Model.Directors) : "N/A")</p>
            <p><strong>Actor(s):</strong> @(Model.Actors != null && Model.Actors.Any() ? string.Join(", ", Model.Actors) : "N/A")</p>
            <p><strong>Description:</strong> @(string.IsNullOrEmpty(Model.Description) ? "No description available." : Model.Description)</p>
            <p class="modal-rating">IMDB: @Model.ImdbRating <i class="fas fa-star gold-star"></i></p>
        </div>
        <div class="modal-buttons">
            <button class="add-to-list-btn" data-item-id="@Model.Id" data-item-type="@Model.Type">
                <i class="fas fa-plus"></i> Add to List
            </button>
            @if (!string.IsNullOrEmpty(Model.TrailerUrl) && Model.TrailerUrl != "#")
            {
                <a href="@Model.TrailerUrl" target="_blank" class="trailer-btn">
                    <i class="fas fa-play"></i> Watch Trailer
                </a>
            }
            else
            {
                <button class="trailer-btn disabled" disabled>
                    <i class="fas fa-play"></i> No Trailer
                </button>
            }
        </div>
    </div>
}
else
{
    <p style="text-align: center; color: #f0f0f0;">Details not found for this item. Please try again.</p>
}