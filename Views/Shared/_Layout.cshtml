<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CinemaHub</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Press+Start+2P&family=Monoton&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/homepage.css" asp-append-version="true" /> @* HomePage özel stillerini ekleyin *@
    <link rel="stylesheet" href="~/css/detailedSearchModal.css" asp-append-version="true" /> @* Detaylı Arama Modal stillerini ekleyin*@
    @RenderSection("Styles", required: false)
</head>
<body class="bg-gray-900 text-gray-200 min-h-screen flex flex-col">

    @Html.Partial("_Navbar") @* Navbar burada HTML olarak render edilir *@

    <main class="flex-grow">
        @RenderBody()
    </main>

    @Html.Partial("_Footer")

    <button class="scroll-top-btn" id="scrollTopBtn" title="Yukarı Çık">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polyline points="7,17 14,10 21,17" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
    </button>

    <script>
        // scrollTopBtn JavaScript'i
        const scrollTopBtn = document.getElementById('scrollTopBtn');
        if (scrollTopBtn) { // Null kontrolü ekledik
            window.addEventListener('scroll', function() {
                if (window.scrollY > 200) {
                    scrollTopBtn.style.opacity = '1';
                    scrollTopBtn.style.pointerEvents = 'auto';
                } else {
                    scrollTopBtn.style.opacity = '0';
                    scrollTopBtn.style.pointerEvents = 'none';
                }
            });

            scrollTopBtn.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }
    </script>

    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>
        AOS.init(); // AOS'u başlatma betiği
    </script>

    <div id="movieDetailModal" class="modal">
        <div class="modal-content">
            <span class="close-button">×</span>
            <div id="modalContentInner">
                @* Bu kısım başlangıçta boş kalacak ve JavaScript ile API çağrısından sonra doldurulacak *@
                @* AJAX çağrısı ile View Component'in render ettiği HTML buraya gelecek *@
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
    <script src="~/js/homepage.js" asp-append-version="true"></script> @* HomePage JS'ini ekleyin *@
    <script src="~/js/detailedSearchModal.js" asp-append-version="true"></script> @* Detaylı Arama Modal JS'ini ekleyin *@
    <script src="~/js/modal-details.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
